    int id_acceso FK
    varchar turno
    date fecha_inicio
    date fecha_fin
  }
  COMPUTADORA {
    int id_computadora PK
    int id_estacion FK, UK
    varchar hostname UK
    inet ip_vpn UK
    varchar estado
  }
  OPERADOR {
    int id_operador PK
    char dpi UK
    varchar nombres
    varchar usuario UK
    varchar turno
    int id_computadora FK
  }
  ENLACE_RED {
    int id_enlace PK
    int id_estacion FK
    varchar rol
    varchar medio
    int ancho_banda_mbps
    varchar protocolo_vpn
  }
